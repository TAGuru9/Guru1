RequestSpecification request = RestAssured.given();

boolean sslEnabled = Boolean.TRUE.equals(testCase.getSslEnabled());
String authType = testCase.getAuthType() == null ? "" : testCase.getAuthType().trim().toUpperCase();

if (sslEnabled) {
    request.config(SSLManager.getSSLConfig());
    System.out.println("SSL certificate configuration applied");
    extentTest.info("SSL certificate configuration applied");
} else {
    request.relaxedHTTPSValidation();
}

if (authType.contains("OAUTH2")) {
    String token = TokenManager.getToken(testCase);
    request.header("Authorization", "Bearer " + token);
    System.out.println("OAuth2 Authorization header added");
    extentTest.info("OAuth2 Authorization header added");
}

if (authType.contains("APIKEY") || authType.contains("API_KEY")) {
    String apiKey = FrameworkConfig.getProperty("api.key");

    if (apiKey == null || apiKey.isBlank()) {
        apiKey = FrameworkConfig.getProperty("request.header.apikey");
    }

    if (apiKey == null || apiKey.isBlank()) {
        throw new RuntimeException("API key missing. Add api.key in qa.properties");
    }

    request.header("apikey", apiKey);
    System.out.println("API key header added");
    extentTest.info("API key header added");
}

request.contentType("application/json");
request.accept("application/json");
