$vmNames = @"
VM01
VM02
VM03
VM04
VM05
"@ -split "`r?`n" | Where-Object { $_.Trim() }

foreach ($vm in $vmNames) {
    try {
        $ip = (Resolve-DnsName $vm -Type A -ErrorAction Stop).IPAddress
        Write-Host "$vm : $ip"
    }
    catch {
        Write-Host "$vm : IP Address Not Found"
    }
}
