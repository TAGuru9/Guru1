DECLARE @ApplicationColumn sysname;
DECLARE @Sql nvarchar(max);

SELECT @ApplicationColumn = SF_COLUMN_NAME
FROM [td].[SYSTEM_FIELD]
WHERE SF_TABLE_NAME = 'TEST'
  AND LTRIM(RTRIM(SF_USER_LABEL)) = 'Application';

IF @ApplicationColumn IS NULL
BEGIN
    THROW 50001,
        'Application field not found. Check its label in SYSTEM_FIELD.',
        1;
END;

SET @Sql = N'
SELECT
    COALESCE(
        NULLIF(
            LTRIM(RTRIM(CONVERT(nvarchar(255), t.'
            + QUOTENAME(@ApplicationColumn) + N'))),
            N''''
        ),
        N''(Blank)''
    ) AS application,
    SUM(CASE WHEN t.TS_NAME LIKE ''TA[_]%'' THEN 1 ELSE 0 END)
        AS automated_count,
    SUM(CASE WHEN t.TS_NAME LIKE ''TA[_]%'' THEN 0 ELSE 1 END)
        AS manual_count
FROM [td].[TEST] t
GROUP BY
    COALESCE(
        NULLIF(
            LTRIM(RTRIM(CONVERT(nvarchar(255), t.'
            + QUOTENAME(@ApplicationColumn) + N'))),
            N''''
        ),
        N''(Blank)''
    )
ORDER BY application;';

EXEC sys.sp_executesql @Sql;
