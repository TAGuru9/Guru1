;WITH Folders AS (
    SELECT
        a.AL_ITEM_ID AS folder_id,
        CAST(a.AL_DESCRIPTION AS nvarchar(max)) AS folder_path
    FROM [amf_isqat_db].[td].[ALL_LISTS] a
    WHERE a.AL_DESCRIPTION = 'Subject'

    UNION ALL

    SELECT
        child.AL_ITEM_ID,
        CAST(
            f.folder_path + N' / ' + child.AL_DESCRIPTION
            AS nvarchar(max)
        )
    FROM [amf_isqat_db].[td].[ALL_LISTS] child
    JOIN Folders f
        ON child.AL_FATHER_ID = f.folder_id
)
SELECT
    f.folder_path,
    SUM(
        CASE
            WHEN t.TS_TEST_ID IS NOT NULL
             AND t.TS_NAME NOT LIKE 'TA[_]%'
            THEN 1 ELSE 0
        END
    ) AS manual_count,
    SUM(
        CASE
            WHEN t.TS_NAME LIKE 'TA[_]%'
            THEN 1 ELSE 0
        END
    ) AS automated_count
FROM Folders f
LEFT JOIN [amf_isqat_db].[td].[TEST] t
    ON t.TS_SUBJECT = f.folder_id
GROUP BY f.folder_id, f.folder_path
ORDER BY f.folder_path
OPTION (MAXRECURSION 0);
