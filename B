SELECT
    CONCAT(YEAR(GETDATE()), '-Q', DATEPART(QUARTER, GETDATE())) AS EXEC_QUARTER,
    R.RN_TESTER_NAME AS TESTER_ID,
    U.FULL_NAME AS TESTER_FULL_NAME,
    R.RN_STATUS AS STATUS,
    COUNT(*) AS TOTAL_EXECUTIONS
FROM [amfc_isqat_db].[td].[run] R
LEFT JOIN qcsitadmin_db_25_1_1.TD.USERS U
    ON R.RN_TESTER_NAME = U.USER_NAME
WHERE
    R.RN_EXECUTION_DATE >= DATEADD(QUARTER, DATEDIFF(QUARTER, 0, GETDATE()), 0)
    AND R.RN_EXECUTION_DATE < DATEADD(QUARTER, DATEDIFF(QUARTER, 0, GETDATE()) + 1, 0)
GROUP BY
    R.RN_TESTER_NAME,
    U.FULL_NAME,
    R.RN_STATUS
ORDER BY
    TESTER_FULL_NAME,
    STATUS;
