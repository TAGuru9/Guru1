// JSON Response Validation using JSONPath
if (testCase.getExpectedBodyJsonPaths() != null
        && !testCase.getExpectedBodyJsonPaths().isEmpty()) {

    JsonPath jsonPathResponse = response.jsonPath();

    for (Map.Entry<String, String> entry :
            testCase.getExpectedBodyJsonPaths().entrySet()) {

        String jsonPath = entry.getKey();
        String expected = replaceContextValues(entry.getValue());

        try {

            Object actualObj = jsonPathResponse.get(jsonPath);

            String actual =
                    actualObj == null
                            ? "null"
                            : actualObj.toString();

            boolean matched;

            // contains validation
            if (expected.startsWith("contains:")) {

                String expectedContains =
                        expected.replace("contains:", "").trim();

                matched = actual.contains(expectedContains);

            }
            // equals validation
            else {

                matched = expected.equals(actual);
            }

            System.out.println(
                    "Type: JSONPATH | Field: "
                            + jsonPath
                            + " | Expected: "
                            + expected
                            + " | Actual: "
                            + actual
                            + " | Result: "
                            + (matched ? "PASS" : "FAIL")
            );

            details.add(new ValidationDetail(
                    "JSONPATH",
                    jsonPath,
                    expected,
                    actual,
                    matched ? "PASS" : "FAIL"
            ));

            if (!matched) {
                finalStatus = "FAIL";
            }

        } catch (Exception e) {

            System.out.println(
                    "Type: JSONPATH | Field: "
                            + jsonPath
                            + " | ERROR: "
                            + e.getMessage()
            );

            details.add(new ValidationDetail(
                    "JSONPATH",
                    jsonPath,
                    expected,
                    "ERROR: " + e.getMessage(),
                    "FAIL"
            ));

            finalStatus = "FAIL";
        }
    }
}
