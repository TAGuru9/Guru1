cd /d "%WORKSPACE%"

echo Workspace=%WORKSPACE%
echo Application=%TA_APPLICATION%
echo TC IDs=%TC_IDS%

if not exist "%WORKSPACE%\uploaded" mkdir "%WORKSPACE%\uploaded"

REM Decode uploaded testcase file if provided
if not "%TC_FILE%"=="" (
    echo %TC_FILE% > "%WORKSPACE%\uploaded\tcFile.b64"
    certutil -decode "%WORKSPACE%\uploaded\tcFile.b64" "%WORKSPACE%\uploaded\testcase.json"
    set TC_FILE_PATH=%WORKSPACE%\uploaded\testcase.json
) else (
    set TC_FILE_PATH=
)

REM Decode uploaded data file if provided
if not "%DATA_FILE%"=="" (
    echo %DATA_FILE% > "%WORKSPACE%\uploaded\dataFile.b64"
    certutil -decode "%WORKSPACE%\uploaded\dataFile.b64" "%WORKSPACE%\uploaded\data.csv"
    set DATA_FILE_PATH=%WORKSPACE%\uploaded\data.csv
) else (
    set DATA_FILE_PATH=
)

echo Final TC File=%TC_FILE_PATH%
echo Final Data File=%DATA_FILE_PATH%

gradlew.bat clean :%TA_APPLICATION%:test ^
-Denv=%TA_ENVTYPE% ^
-Dids=%TC_IDS% ^
-Dproject=project-%TA_APPLICATION% ^
-DtcFile="%TC_FILE_PATH%" ^
-DdataFile="%DATA_FILE_PATH%" ^
-DkpiArgs=framework=%TA_FRAMEWORK%;site=%TA_SITE%;changeId=%TA_CHANGEID%;product=%TA_PRODUCT%;application=%TA_APPLICATION%;env=%TA_ENVTYPE%;release=%TA_RELEASE%;testSuiteType=%TA_TESTSUITE_TYPE%;repository=%TA_REPOSITORY%;branch=%TA_BUILD_GIT_BRANCH%;testSuiteArgs=%TA_TESTSUITE_ARGS%;buildUrl=%BUILD_URL%;executor=%BUILD_USER_ID%;executionSource=Jenkins ^
--rerun-tasks --no-build-cache
