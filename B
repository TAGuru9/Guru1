public static Path resolve(String inputPath) {

    if (inputPath == null || inputPath.isBlank()) {
        throw new IllegalArgumentException("Input path is blank");
    }

    String trimmed = inputPath.trim();

    // 1. Direct / absolute path (uploaded payload or full path)
    Path direct = Paths.get(trimmed);

    if (Files.exists(direct)) {
        return direct.toAbsolutePath().normalize();
    }

    // 2. Jenkins payloadBasePath
    String payloadBasePath = System.getProperty("payloadBasePath");

    if (payloadBasePath != null && !payloadBasePath.isBlank()) {

        Path jenkinsPath = Paths.get(payloadBasePath)
                .resolve(trimmed)
                .normalize();

        if (Files.exists(jenkinsPath)) {
            return jenkinsPath.toAbsolutePath().normalize();
        }
    }

    // 3. IDE run (project-cdr / project-memberEligibility)
    Path idePath = Paths.get(
            System.getProperty("user.dir"),
            "src",
            "test",
            "resources"
    ).resolve(trimmed).normalize();

    if (Files.exists(idePath)) {
        return idePath.toAbsolutePath().normalize();
    }

    throw new RuntimeException(
            "File not found. Checked paths for: "
                    + inputPath
                    + "\nDirect: " + direct.toAbsolutePath()
                    + "\nJenkins: " + payloadBasePath
                    + "\nIDE: " + idePath
    );
}
