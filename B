skipped;

        System.out.println();

        System.out.println("====================================");

        System.out.println("       EXTENT TEST SUMMARY");

        System.out.println("====================================");

        System.out.println("Total   : " + total);

        System.out.println("Passed  : " + passed);

        System.out.println("Failed  : " + failed);

        System.out.println("Skipped : " + skipped);

        System.out.println("====================================");

        // Send final counts to KPI

        KpiWriter.writeSuiteSummary(

                (int) total,

                (int) passed,

                (int) failed,

                (int) skipped

        );

    } catch (Exception e) {

        // KPI problem should NOT stop report generation

        System.err.println(

                "Unable to write Extent KPI summary: "

                        + e.getMessage()

        );

    } finally {

        // Always generate Extent report

        extent.flush();

    }

}
