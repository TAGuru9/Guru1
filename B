
init.fields.ClickIt(menu.lnkMenu, "Click Menu");
init.fields.ClickIt(menu.lnkAdmin, "Administration");

// Administration submenu locator
By adminOptions = By.xpath(
    "//a[@id='_topmenulink_Menu_Administration']" +
    "/following-sibling::ul[@role='menu']//a"
);

// Get all submenu items
List<WebElement> orgMenu =
    init.driver.findElements(adminOptions);

boolean orgFound = false;

for (WebElement item : orgMenu) {

    String menuName = item.getText().trim();

    System.out.println("Admin Menu: " + menuName);

    if (menuName.equalsIgnoreCase("Organization")
            && item.isDisplayed()) {

        init.fields.ClickIt(item, "Organization");

        init.reporter.Event(
            "PASS",
            "Organization",
            "Organization menu is present and clicked"
        );

        init.reporter.AttachScreenShotToTest(init.driver);

        orgFound = true;
        break;
    }
}

if (!orgFound) {

    init.reporter.Event(
        "INFO",
        "Organization Access",
        "Organization menu is not available in this environment"
    );

    init.reporter.AttachScreenShotToTest(init.driver);

    System.out.println(
        "Organization menu is not present for this user."
    );
}
