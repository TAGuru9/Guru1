private String resolvePayloadFile(TestCase testCase) {

    String method = testCase.getMethod();

    // GET / DELETE usually no payload needed
    if (method != null &&
            (method.equalsIgnoreCase("GET")
                    || method.equalsIgnoreCase("DELETE"))) {

        System.out.println("No payload required for method: " + method);
        return null;
    }

    String runtimePayloadFile =
            System.getProperty("payloadFile", "").trim();

    if (!runtimePayloadFile.isBlank()) {
        System.out.println("Using runtime payload file: " + runtimePayloadFile);
        return runtimePayloadFile;
    }

    String tcPayloadFile = testCase.getPayloadFile();

    if (tcPayloadFile != null
            && !tcPayloadFile.trim().isBlank()
            && !tcPayloadFile.trim().equalsIgnoreCase("${payloadFile}")) {

        String payload = tcPayloadFile.trim();

        if (!java.nio.file.Paths.get(payload).isAbsolute()
                && !payload.contains("src/test/resources")
                && !payload.contains("src\\test\\resources")) {

            payload = java.nio.file.Paths
                    .get("src", "test", "resources")
                    .resolve(payload)
                    .toString();
        }

        System.out.println("Using test case payload file: " + payload);
        return payload;
    }

    throw new RuntimeException(
            "Payload file is missing for method: " + method
    );
}
