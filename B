SELECT
    YEAR(R.RN_EXECUTION_DATE) AS EXEC_YEAR,

    CAST(R.RN_EXECUTION_DATE AS DATE) AS EXEC_DATE,

    DATEADD(WEEK, DATEDIFF(WEEK, 0, R.RN_EXECUTION_DATE), 0) AS WEEK_START_DATE,
    DATEADD(DAY, 6, DATEADD(WEEK, DATEDIFF(WEEK, 0, R.RN_EXECUTION_DATE), 0)) AS WEEK_END_DATE,

    FORMAT(R.RN_EXECUTION_DATE, 'yyyy-MM') AS EXEC_MONTH,

    CONCAT(
        YEAR(R.RN_EXECUTION_DATE),
        '-Q',
        DATEPART(QUARTER, R.RN_EXECUTION_DATE)
    ) AS EXEC_QUARTER,

    R.RN_TESTER_NAME AS TESTER_ID,
    U.FULL_NAME AS TESTER_FULL_NAME,

    R.RN_STATUS AS STATUS,

    COUNT(*) AS TOTAL_EXECUTIONS

FROM [amfc_isqat_db].[td].[run] R
LEFT JOIN qcsitadmin_db_25_1_1.TD.USERS U
    ON R.RN_TESTER_NAME = U.USER_NAME

WHERE
    R.RN_EXECUTION_DATE >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1)
    AND R.RN_EXECUTION_DATE < DATEFROMPARTS(YEAR(GETDATE()) + 1, 1, 1)

GROUP BY
    YEAR(R.RN_EXECUTION_DATE),
    CAST(R.RN_EXECUTION_DATE AS DATE),
    DATEADD(WEEK, DATEDIFF(WEEK, 0, R.RN_EXECUTION_DATE), 0),
    FORMAT(R.RN_EXECUTION_DATE, 'yyyy-MM'),
    DATEPART(QUARTER, R.RN_EXECUTION_DATE),
    R.RN_TESTER_NAME,
    U.FULL_NAME,
    R.RN_STATUS

ORDER BY
    EXEC_DATE,
    TESTER_FULL_NAME,
    STATUS;
