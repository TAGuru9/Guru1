SELECT
    DATEADD(WEEK, DATEDIFF(WEEK, 0, R.RN_EXECUTION_DATE), 0) AS WEEK_START_DATE,
    DATEADD(DAY, 6, DATEADD(WEEK, DATEDIFF(WEEK, 0, R.RN_EXECUTION_DATE), 0)) AS WEEK_END_DATE,
    R.RN_TESTER_NAME AS TESTER_ID,
    U.FULL_NAME AS TESTER_FULL_NAME,
    R.RN_STATUS AS STATUS,
    COUNT(*) AS TOTAL_EXECUTIONS
FROM [amfc_isqat_db].[td].[run] R
LEFT JOIN qcsitadmin_db_25_1_1.TD.USERS U
    ON R.RN_TESTER_NAME = U.USER_NAME
GROUP BY
    DATEADD(WEEK, DATEDIFF(WEEK, 0, R.RN_EXECUTION_DATE), 0),
    R.RN_TESTER_NAME,
    U.FULL_NAME,
    R.RN_STATUS
ORDER BY
    WEEK_START_DATE,
    TESTER_FULL_NAME,
    STATUS;
