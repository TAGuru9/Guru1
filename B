REM PAYLOAD FILE upload
set "PAYLOAD_CONTENT="
set "PAYLOAD_NAME="

if not "%PAYLOAD_FILE%"=="" (
    set "PAYLOAD_CONTENT=%PAYLOAD_FILE%"
    set "PAYLOAD_NAME=%PAYLOAD_FILE_FILENAME%"
)

if not "%PAYLOAD_File%"=="" (
    set "PAYLOAD_CONTENT=%PAYLOAD_File%"
    set "PAYLOAD_NAME=%PAYLOAD_File_FILENAME%"
)

if not "!PAYLOAD_CONTENT!"=="" (
    if "!PAYLOAD_NAME!"=="" set "PAYLOAD_NAME=payload.json"

    set "UPLOAD_PAYLOAD=!UPLOAD_DIR!\!PAYLOAD_NAME!"

    echo Saving PAYLOAD file...
    echo Payload save path = !UPLOAD_PAYLOAD!

    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "[IO.File]::WriteAllBytes($env:UPLOAD_PAYLOAD,[Convert]::FromBase64String($env:PAYLOAD_CONTENT))"

    if exist "!UPLOAD_PAYLOAD!" (
        echo PAYLOAD file saved successfully:
        echo !UPLOAD_PAYLOAD!
        set "RUN_ARGS=!RUN_ARGS! -DpayloadFile=!UPLOAD_PAYLOAD!"
    ) else (
        echo ERROR: PAYLOAD file was not saved.
        exit /b 1
    )
) else (
    echo No PAYLOAD_FILE uploaded. Framework will use testcase payload.
)
