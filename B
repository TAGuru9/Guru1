SELECT
    FORMAT(R.RN_EXECUTION_DATE, 'yyyy-MM') AS EXEC_MONTH,
    R.RN_TESTER_NAME AS TESTER_ID,
    U.FULL_NAME AS TESTER_FULL_NAME,
    R.RN_STATUS AS STATUS,
    COUNT(*) AS TOTAL_EXECUTIONS
FROM [amfc_isqat_db].[td].[run] R
LEFT JOIN qcsitadmin_db_25_1_1.TD.USERS U
    ON R.RN_TESTER_NAME = U.USER_NAME
WHERE
    R.RN_EXECUTION_DATE >= DATEFROMPARTS(YEAR(GETDATE()), 1, 1)
    AND R.RN_EXECUTION_DATE < DATEFROMPARTS(YEAR(GETDATE()) + 1, 1, 1)
GROUP BY
    FORMAT(R.RN_EXECUTION_DATE, 'yyyy-MM'),
    R.RN_TESTER_NAME,
    U.FULL_NAME,
    R.RN_STATUS
ORDER BY
    EXEC_MONTH,
    TESTER_FULL_NAME,
    STATUS;
