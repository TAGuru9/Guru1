@echo off
setlocal EnableDelayedExpansion
cd /d "%WORKSPACE%"
echo ==========================================
echo Jenkins Runtime Inputs
echo ==========================================
echo WORKSPACE=%WORKSPACE%
echo TA_APPLICATION=%TA_APPLICATION%
echo TA_ENVTYPE=%TA_ENVTYPE%
echo ENVTYPE=%ENVTYPE%
echo TC_IDS=%TC_IDS%
echo TC_FILE=%TC_FILE%
echo DATA_FILE=%DATA_FILE%
echo PAYLOAD_FILE=%PAYLOAD_FILE%
echo ==========================================
REM ==========================================
REM PROJECT NAME
REM ==========================================
set PROJECT_NAME=
if /I "%TA_APPLICATION%"=="cdr" set PROJECT_NAME=project-cdr
if /I "%TA_APPLICATION%"=="membereligibility" set PROJECT_NAME=project-membereligibility
if "%PROJECT_NAME%"=="" (
    echo ERROR: Invalid TA_APPLICATION=%TA_APPLICATION%
    exit /b 1
)
REM Use TA_ENVTYPE first. If empty, use ENVTYPE.
set RUN_ENV=%TA_ENVTYPE%
if "%RUN_ENV%"=="" set RUN_ENV=%ENVTYPE%
if "%RUN_ENV%"=="" (
    echo ERROR: Environment is empty. Please set TA_ENVTYPE or ENVTYPE.
    exit /b 1
)
set RUN_ARGS=
if not exist "%WORKSPACE%\uploaded" mkdir "%WORKSPACE%\uploaded"
REM ==========================================
REM TC_FILE OPTIONAL
REM If uploaded, use uploaded testcase.json
REM Else use TC_IDS from framework
REM ==========================================
if not "%TC_FILE%"=="" (
    echo Uploaded TC_FILE detected
    powershell -Command "[System.IO.File]::WriteAllBytes('%WORKSPACE%\uploaded\testcase.json', [System.Convert]::FromBase64String($env:TC_FILE))"
    if exist "%WORKSPACE%\uploaded\testcase.json" (
        echo Validating testcase JSON...
        powershell -Command "try { Get-Content '%WORKSPACE%\uploaded\testcase.json' -Raw | ConvertFrom-Json | Out-Null; Write-Host 'VALID_JSON'; exit 0 } catch { Write-Host 'INVALID_JSON'; Write-Host $_.Exception.Message; exit 1 }"
        if errorlevel 1 (
            echo ERROR: Invalid testcase JSON format
            exit /b 1
        )
        echo Testcase JSON validation successful
        dir "%WORKSPACE%\uploaded\testcase.json"
        set RUN_ARGS=!RUN_ARGS! -DtcFile="%WORKSPACE%\uploaded\testcase.json"
    ) else (
        echo ERROR: testcase.json was not created
        exit /b 1
    )
) else (
    echo No TC_FILE uploaded. Using framework TC_IDS.
    set RUN_ARGS=!RUN_ARGS! -Dids=%TC_IDS%
)
REM ==========================================
REM DATA_FILE OPTIONAL
REM If uploaded, use uploaded data.csv
REM Else framework/testcase will continue without data file
REM ==========================================
if not "%DATA_FILE%"=="" (
    echo Uploaded DATA_FILE detected
    powershell -Command "[System.IO.File]::WriteAllBytes('%WORKSPACE%\uploaded\data.csv', [System.Convert]::FromBase64String($env:DATA_FILE))"
    if exist "%WORKSPACE%\uploaded\data.csv" (
        echo Validating CSV file...
        powershell -Command "try { $csv = Import-Csv '%WORKSPACE%\uploaded\data.csv'; if ($csv.Count -eq 0) { throw 'CSV has no data rows' }; $headers = Get-Content '%WORKSPACE%\uploaded\data.csv' -First 1; if ([string]::IsNullOrWhiteSpace($headers)) { throw 'CSV header row missing' }; Write-Host 'VALID_CSV'; exit 0 } catch { Write-Host 'INVALID_CSV'; Write-Host $_.Exception.Message; exit 1 }"
        if errorlevel 1 (
            echo ERROR: Invalid CSV file
            exit /b 1
        )
        echo CSV validation successful
        dir "%WORKSPACE%\uploaded\data.csv"
        set RUN_ARGS=!RUN_ARGS! -DdataFile="%WORKSPACE%\uploaded\data.csv"
    ) else (
        echo ERROR: data.csv was not created
        exit /b 1
    )
) else (
    echo No DATA_FILE uploaded.
)
REM ==========================================
REM PAYLOAD_FILE OPTIONAL
REM If uploaded, use uploaded payload.json
REM Else framework uses payloadFile from testcase JSON
REM ==========================================
if not "%PAYLOAD_FILE%"=="" (
    echo Uploaded PAYLOAD_FILE detected
    powershell -Command "[System.IO.File]::WriteAllBytes('%WORKSPACE%\uploaded\payload.json', [System.Convert]::FromBase64String($env:PAYLOAD_FILE))"
    if exist "%WORKSPACE%\uploaded\payload.json" (
        echo Validating payload JSON...
        powershell -Command "try { Get-Content '%WORKSPACE%\uploaded\payload.json' -Raw | ConvertFrom-Json | Out-Null; Write-Host 'VALID_PAYLOAD_JSON'; exit 0 } catch { Write-Host 'INVALID_PAYLOAD_JSON'; Write-Host $_.Exception.Message; exit 1 }"
        if errorlevel 1 (
            echo ERROR: Invalid payload JSON format
            exit /b 1
        )
        echo Payload JSON validation successful
        dir "%WORKSPACE%\uploaded\payload.json"
        set RUN_ARGS=!RUN_ARGS! -DpayloadFile="%WORKSPACE%\uploaded\payload.json"
    ) else (
        echo ERROR: payload.json was not created
        exit /b 1
    )
) else (
    echo No PAYLOAD_FILE uploaded. Framework will use payloadFile from testcase JSON.
)
REM ==========================================
REM COPY UPLOADED FILES TO REPORT FOLDER
REM ==========================================
set REPORT_DIR=%WORKSPACE%\%PROJECT_NAME%\build\reports
if not exist "%REPORT_DIR%" mkdir "%REPORT_DIR%"
if exist "%WORKSPACE%\uploaded\testcase.json" copy /Y "%WORKSPACE%\uploaded\testcase.json" "%REPORT_DIR%"
if exist "%WORKSPACE%\uploaded\data.csv" copy /Y "%WORKSPACE%\uploaded\data.csv" "%REPORT_DIR%"
if exist "%WORKSPACE%\uploaded\payload.json" copy /Y "%WORKSPACE%\uploaded\payload.json" "%REPORT_DIR%"
echo ==========================================
echo Final Execution Details
echo ==========================================
echo PROJECT_NAME=%PROJECT_NAME%
echo RUN_ENV=%RUN_ENV%
echo FINAL RUN_ARGS=!RUN_ARGS!
dir "%WORKSPACE%\uploaded"
echo ==========================================
REM ==========================================
REM EXECUTE FRAMEWORK
REM ==========================================
call gradlew.bat clean :%PROJECT_NAME%:test ^
-Denv=%RUN_ENV% ^
!RUN_ARGS! ^
-DgitArgs=framework=%TA_FRAMEWORK%;site=%TA_SITE%;changeId=%TA_CHANGE_ID%;product=%TA_PRODUCT%;application=%TA_APPLICATION%;env=%RUN_ENV%;release=%TA_RELEASE%;testSuiteType=%TA_TESTSUITETYPE%;repoHistory=%TA_REPOSITORY%;gitBranch=%TA_BUILD_GIT_BRANCH%;buildUrl=%BUILD_URL%;executor=%BUILD_USER_ID%;executionSource=Jenkins;vm=%COMPUTERNAME% ^
--rerun-tasks --no-build-cache --stacktrace
endlocal
