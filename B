@echo off
setlocal EnableDelayedExpansion

cd /d "%WORKSPACE%"

echo ==========================================
echo API Framework Jenkins Run
echo ==========================================
echo WORKSPACE         = %WORKSPACE%
echo TA_PRODUCT        = %TA_PRODUCT%
echo TA_ENVTYPE        = %TA_ENVTYPE%
echo TA_TESTSUITE_TYPE = %TA_TESTSUITE_TYPE%
echo TC_IDS            = %TC_IDS%
echo TC_File           = %TC_File%
echo Payload_File      = %Payload_File%
echo Data_File         = %Data_File%
echo ==========================================

REM Create project name from TA_PRODUCT
set "PROJECT_NAME="

if /I "%TA_PRODUCT%"=="cdr" set "PROJECT_NAME=project-cdr"
if /I "%TA_PRODUCT%"=="memberEligibility" set "PROJECT_NAME=project-memberEligibility"
if /I "%TA_PRODUCT%"=="provider" set "PROJECT_NAME=project-provider"
if /I "%TA_PRODUCT%"=="claims" set "PROJECT_NAME=project-claims"

if "%PROJECT_NAME%"=="" (
    echo ERROR: Invalid TA_PRODUCT: %TA_PRODUCT%
    exit /b 1
)

echo PROJECT_NAME = %PROJECT_NAME%

REM Create uploaded folder inside workspace/project
set "UPLOAD_DIR=%WORKSPACE%\%PROJECT_NAME%\uploaded"

if not exist "%UPLOAD_DIR%" (
    mkdir "%UPLOAD_DIR%"
)

echo Upload folder = %UPLOAD_DIR%

REM Copy uploaded TC file
set "TC_FILE_PATH="
if not "%TC_File%"=="" (
    if exist "%TC_File%" (
        copy /Y "%TC_File%" "%UPLOAD_DIR%\%TC_File_FILENAME%"
        set "TC_FILE_PATH=%UPLOAD_DIR%\%TC_File_FILENAME%"
    ) else (
        echo ERROR: TC file not found: %TC_File%
        exit /b 1
    )
)

REM Copy uploaded payload file
set "PAYLOAD_FILE_PATH="
if not "%Payload_File%"=="" (
    if exist "%Payload_File%" (
        copy /Y "%Payload_File%" "%UPLOAD_DIR%\%Payload_File_FILENAME%"
        set "PAYLOAD_FILE_PATH=%UPLOAD_DIR%\%Payload_File_FILENAME%"
    ) else (
        echo ERROR: Payload file not found: %Payload_File%
        exit /b 1
    )
)

REM Copy uploaded data file
set "DATA_FILE_PATH="
if not "%Data_File%"=="" (
    if exist "%Data_File%" (
        copy /Y "%Data_File%" "%UPLOAD_DIR%\%Data_File_FILENAME%"
        set "DATA_FILE_PATH=%UPLOAD_DIR%\%Data_File_FILENAME%"
    ) else (
        echo ERROR: Data file not found: %Data_File%
        exit /b 1
    )
)

echo ==========================================
echo Final File Paths Used By Framework
echo ==========================================
echo TC_FILE_PATH      = %TC_FILE_PATH%
echo PAYLOAD_FILE_PATH = %PAYLOAD_FILE_PATH%
echo DATA_FILE_PATH    = %DATA_FILE_PATH%
echo ==========================================

echo Files in uploaded folder:
dir "%UPLOAD_DIR%"

echo ==========================================
echo Running API Framework
echo ==========================================

call gradlew.bat clean test ^
 -Dta.product="%TA_PRODUCT%" ^
 -Dproject.name="%PROJECT_NAME%" ^
 -Dta.envtype="%TA_ENVTYPE%" ^
 -Dta.testsuite.type="%TA_TESTSUITE_TYPE%" ^
 -Dtc.ids="%TC_IDS%" ^
 -Dtc.file="%TC_FILE_PATH%" ^
 -Dpayload.file="%PAYLOAD_FILE_PATH%" ^
 -Ddata.file="%DATA_FILE_PATH%"

set "EXIT_CODE=%ERRORLEVEL%"

echo ==========================================
echo Framework finished with exit code: %EXIT_CODE%
echo ==========================================

exit /b %EXIT_CODE%
