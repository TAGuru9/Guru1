.loadKeyMaterial(
        keyStore,
        keyStorePassword.toCharArray(),
        (aliases, socket) -> {
            System.out.println("Available client cert aliases from SSL handshake: " + aliases.keySet());
            System.out.println("Configured ssl.key.alias: " + keyAlias);

            if (keyAlias != null && aliases.containsKey(keyAlias)) {
                System.out.println("Using configured SSL alias: " + keyAlias);
                return keyAlias;
            }

            String firstAlias = aliases.keySet().iterator().next();
            System.out.println("Configured alias not found. Using first SSL alias: " + firstAlias);
            return firstAlias;
        }
)
