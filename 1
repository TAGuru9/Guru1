DECLARE @SQL NVARCHAR(MAX);

SELECT @SQL = STRING_AGG(
    CAST(
        'SELECT ''' + COLUMN_NAME + ''' AS Column_Name,
                CAST(' + QUOTENAME(COLUMN_NAME) +
                ' AS NVARCHAR(4000)) AS Field_Value,
                COUNT(*) AS Defect_Count
         FROM [amfc_isqat_db].[td].[BUG]
         WHERE BG_DETECTION_DATE >= ''2026-01-01''
           AND BG_DETECTION_DATE < ''2027-01-01''
           AND (
                UPPER(LTRIM(RTRIM(CAST(' +
                QUOTENAME(COLUMN_NAME) +
                ' AS NVARCHAR(4000))))) LIKE ''%QA%''
                OR UPPER(LTRIM(RTRIM(CAST(' +
                QUOTENAME(COLUMN_NAME) +
                ' AS NVARCHAR(4000))))) LIKE ''%UAT%''
           )
         GROUP BY ' + QUOTENAME(COLUMN_NAME)
        AS NVARCHAR(MAX)
    ),
    ' UNION ALL '
)
FROM [amfc_isqat_db].INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'td'
  AND TABLE_NAME = 'BUG'
  AND COLUMN_NAME LIKE 'BG_USER[_]%';

IF @SQL IS NOT NULL
    EXEC sp_executesql @SQL;
