

/* ACFC login form sizing */

.login-container,
.login-container form,
.login-container .login-form {
  font-size: 16px !important;
}

.login-container input,
.login-container button {
  font-size: 16px !important;
  min-height: 42px;
}

.login-container h1,
.login-container h2 {
  font-size: 28px !important;
  line-height: 1.3;
}

/* Keep the login panel readable */
.login-container {
  width: 100% !important;
  max-width: 460px !important;
}

/* Avoid changing the sign-in fields' behavior */
.login-container input {
  box-sizing: border-box;
}
