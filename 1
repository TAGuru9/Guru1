
/* ========================================
   ACFC TA RESPONSIVE LAYOUT FIX V6
   ======================================== */

/* Allow flexible sizing */
html,
body.app-sign-in-register {
  width: 100% !important;
  min-width: 0 !important;
  overflow-x: hidden !important;
}

/* Center entire login */
.app-sign-in-register__content,
#main-panel {
  box-sizing: border-box !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: none !important;
  min-height: 100vh !important;

  padding: clamp(12px, 3vw, 40px) !important;
  margin: 0 !important;

  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}

/* Main card - two columns when space allows */
.app-sign-in-register__content-inner {
  position: relative !important;
  display: block !important;

  box-sizing: border-box !important;
  width: min(1100px, 100%) !important;
  max-width: 1100px !important;
  min-width: 0 !important;
  min-height: 0 !important;

  padding:
    clamp(28px, 5vw, 55px)
    clamp(26px, 4vw, 48px)
    clamp(28px, 5vw, 55px)
    54% !important;

  margin: 0 auto !important;

  overflow: visible !important;
}

/* Left hero - independent from login form */
.acfc-split-hero {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;

  box-sizing: border-box !important;
  width: 49% !important;
  height: 100% !important;

  padding: clamp(18px, 3vw, 32px) !important;
  overflow-y: auto !important;
}

/* Ensure login content has available width */
.app-sign-in-register__content-inner
  > :not(.acfc-split-hero) {
  box-sizing: border-box !important;
  display: block !important;
  grid-area: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  float: none !important;
}

/* Keep the heading readable */
.app-sign-in-register__content-inner h1 {
  display: block !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;

  margin: 0 0 24px !important;

  font-size: clamp(22px, 2.3vw, 30px) !important;
  line-height: 1.3 !important;
  white-space: normal !important;
  overflow-wrap: normal !important;
}

/* Native Jenkins form sizing */
.app-sign-in-register form {
  display: block !important;

  box-sizing: border-box !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;

  margin: 0 !important;
  padding: 0 !important;
}

/* Form fields */
.app-sign-in-register
input[type="text"],
.app-sign-in-register
input[type="password"] {
  box-sizing: border-box !important;

  display: block !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;

  min-height: 44px !important;
}

/* Submit button */
.app-sign-in-register
button[type="submit"],
.app-sign-in-register
input[type="submit"] {
  box-sizing: border-box !important;
  display: block !important;
  width: 100% !important;
  min-height: 44px !important;
}

/* Remove obsolete grid placement */
.app-sign-in-register__content-inner
> :not(.acfc-split-hero) {
  grid-column: auto !important;
  grid-row: auto !important;
}

/* Responsive layout */
@media (max-width: 900px) {

  .app-sign-in-register__content-inner {
    width: min(620px, 100%) !important;
    max-width: 620px !important;
    padding: 26px !important;
  }

  .acfc-split-hero {
    position: relative !important;
    width: 100% !important;
    height: auto !important;

    padding: 24px !important;
    margin-bottom: 28px !important;

    border-right: none !important;
    border-bottom:
      1px solid rgba(95,214,255,.2);
    border-radius: 16px !important;
  }

  .acfc-login-footer {
    margin-top: 22px !important;
  }
}

/* Small mobile screens */
@media (max-width: 480px) {

  .app-sign-in-register__content,
  #main-panel {
    padding: 12px !important;
  }

  .app-sign-in-register__content-inner {
    width: 100% !important;
    padding: 18px !important;
    border-radius: 16px !important;
  }

  .acfc-split-hero {
    padding: 16px !important;
  }

  .acfc-hero-brand h2 {
    font-size: 21px !important;
  }

  .acfc-robot-stage {
    height: 240px !important;
  }
}
