

;WITH ReleaseCycles AS (
    SELECT
        rel.REL_ID,
        rel.REL_NAME,
        rc.RCYC_ID,
        rc.RCYC_NAME,
        rc.RCYC_START_DATE,
        rc.RCYC_END_DATE,
        CAST(rc.RCYC_START_DATE AS DATE) AS Week1_Start,
        DATEADD(
            DAY, 7,
            CAST(rc.RCYC_START_DATE AS DATE)
        ) AS Week1_End_Exclusive
    FROM [amfc_isqat_db].[td].RELEASE_CYCLES rc
    INNER JOIN [amfc_isqat_db].[td].RELEASES rel
        ON rel.REL_ID = rc.RCYC_PARENT_ID
    WHERE rc.RCYC_START_DATE >=
          DATEFROMPARTS(YEAR(GETDATE()), 1, 1)
      AND rc.RCYC_START_DATE <
          DATEFROMPARTS(YEAR(GETDATE()) + 1, 1, 1)
),

FirstRuns AS (
    SELECT
        r.RN_TESTCYCL_ID,
        r.RN_RUN_ID,
        r.RN_STATUS,
        r.RN_EXECUTION_DATE,
        c.CY_ASSIGN_RCYC,
        cf.CF_ITEM_NAME AS Application,
        ROW_NUMBER() OVER (
            PARTITION BY r.RN_TESTCYCL_ID
            ORDER BY
                r.RN_EXECUTION_DATE,
                r.RN_EXECUTION_TIME,
                r.RN_RUN_ID
        ) AS RunRank
    FROM [amfc_isqat_db].[td].RUN r
    INNER JOIN [amfc_isqat_db].[td].TESTCYCL tc
        ON r.RN_TESTCYCL_ID = tc.TC_TESTCYCL_ID
    INNER JOIN [amfc_isqat_db].[td].CYCLE c
        ON tc.TC_CYCLE_ID = c.CY_CYCLE_ID
    LEFT JOIN [amfc_isqat_db].[td].CYCL_FOLD cf
        ON c.CY_FOLDER_ID = cf.CF_ITEM_ID
),

MetricRows AS (

    -- First-week defects
    SELECT
        rc.REL_ID,
        rc.REL_NAME,
        rc.RCYC_ID,
        rc.RCYC_NAME,
        rc.RCYC_START_DATE,
        rc.RCYC_END_DATE,
        rc.Week1_Start,
        rc.Week1_End_Exclusive,

        COALESCE(
            NULLIF(bg.BG_PROJECT, ''),
            'Unspecified'
        ) AS Application,

        COUNT(DISTINCT bg.BG_BUG_ID)
            AS Total_Defects,

        COUNT(DISTINCT CASE
            WHEN bg.BG_SEVERITY IN
                ('3-High', '4-Very High', '5-Urgent')
            THEN bg.BG_BUG_ID
        END) AS High_Defects,

        0 AS First_Run_Tests,
        0 AS First_Pass,
        0 AS First_Fail

    FROM ReleaseCycles rc
    INNER JOIN [amfc_isqat_db].[td].BUG bg
        ON bg.BG_DETECTED_IN_RCYC = rc.RCYC_ID
       AND bg.BG_DETECTION_DATE >= rc.Week1_Start
       AND bg.BG_DETECTION_DATE <
           rc.Week1_End_Exclusive

    GROUP BY
        rc.REL_ID,
        rc.REL_NAME,
        rc.RCYC_ID,
        rc.RCYC_NAME,
        rc.RCYC_START_DATE,
        rc.RCYC_END_DATE,
        rc.Week1_Start,
        rc.Week1_End_Exclusive,
        COALESCE(
            NULLIF(bg.BG_PROJECT, ''),
            'Unspecified'
        )

    UNION ALL

    -- First-pass execution metrics
    SELECT
        rc.REL_ID,
        rc.REL_NAME,
        rc.RCYC_ID,
        rc.RCYC_NAME,
        rc.RCYC_START_DATE,
        rc.RCYC_END_DATE,
        rc.Week1_Start,
        rc.Week1_End_Exclusive,

        COALESCE(
            NULLIF(fr.Application, ''),
            'Unspecified'
        ) AS Application,

        0 AS Total_Defects,
        0 AS High_Defects,

        COUNT(*) AS First_Run_Tests,

        SUM(CASE
            WHEN fr.RN_STATUS = 'Passed'
            THEN 1 ELSE 0
        END) AS First_Pass,

        SUM(CASE
            WHEN fr.RN_STATUS = 'Failed'
            THEN 1 ELSE 0
        END) AS First_Fail

    FROM ReleaseCycles rc
    INNER JOIN FirstRuns fr
        ON fr.CY_ASSIGN_RCYC = rc.RCYC_ID
       AND fr.RunRank = 1
       AND fr.RN_EXECUTION_DATE >= rc.Week1_Start
       AND fr.RN_EXECUTION_DATE <
           rc.Week1_End_Exclusive

    GROUP BY
        rc.REL_ID,
        rc.REL_NAME,
        rc.RCYC_ID,
        rc.RCYC_NAME,
        rc.RCYC_START_DATE,
        rc.RCYC_END_DATE,
        rc.Week1_Start,
        rc.Week1_End_Exclusive,
        COALESCE(
            NULLIF(fr.Application, ''),
            'Unspecified'
        )
)

SELECT
    YEAR(Week1_Start) AS Report_Year,

    Application,

    REL_NAME AS Release_Name,

    RCYC_NAME AS Cycle_Name,

    CAST(RCYC_START_DATE AS DATE) AS Cycle_Start,

    CAST(RCYC_END_DATE AS DATE) AS Cycle_End,

    Week1_Start,

    DATEADD(DAY, -1, Week1_End_Exclusive)
        AS Week1_End,

    SUM(Total_Defects)
        AS First_Week_Defects,

    SUM(High_Defects)
        AS High_Severity_Defects,

    SUM(First_Run_Tests)
        AS First_Run_Tests,

    SUM(First_Pass)
        AS First_Pass_Count,

    SUM(First_Fail)
        AS First_Fail_Count,

    CAST(
        100.0 * SUM(First_Pass) /
        NULLIF(SUM(First_Run_Tests), 0)
        AS DECIMAL(6,2)
    ) AS First_Pass_Percentage,

    CAST(
        100.0 * SUM(First_Fail) /
        NULLIF(SUM(First_Run_Tests), 0)
        AS DECIMAL(6,2)
    ) AS First_Fail_Percentage

FROM MetricRows

GROUP BY
    Application,
    REL_NAME,
    RCYC_NAME,
    RCYC_START_DATE,
    RCYC_END_DATE,
    Week1_Start,
    Week1_End_Exclusive

ORDER BY
    Release_Name,
    Application,
    Cycle_Start;
