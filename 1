/* =========================================
   ACFC TA PRODUCTION - FULL ROBOT LOGIN
   Safe version: robot above, native form below
   ========================================= */

:root {
  --acfc-bg-1: #071525;
  --acfc-bg-2: #12375b;
  --acfc-panel: #10233b;
  --acfc-panel-2: rgba(8, 24, 40, 0.85);
  --acfc-border: #317caf;
  --acfc-cyan: #59eaff;
  --acfc-text: #ffffff;
  --acfc-soft: #d5e9fb;
  --acfc-muted: #a8c9e3;
  --acfc-btn1: #087cf5;
  --acfc-btn2: #09b4e5;
}

/* Page background */
html,
body.app-sign-in-register {
  min-height: 100% !important;
  margin: 0 !important;
  background: linear-gradient(135deg, var(--acfc-bg-1), var(--acfc-bg-2), #071525) !important;
  color: var(--acfc-text) !important;
  overflow-x: hidden !important;
}

/* Hide default Jenkins left artwork/logo */
.app-sign-in-register__branding,
.app-sign-in-register__content-logo {
  display: none !important;
}

/* Main page container */
.app-sign-in-register__content,
#main-panel {
  min-height: 100vh !important;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 28px 18px !important;
  box-sizing: border-box !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  background:
    radial-gradient(circle at 20% 20%, rgba(0,180,255,.15), transparent 28%),
    radial-gradient(circle at 80% 70%, rgba(70,120,255,.12), transparent 30%),
    linear-gradient(135deg, #071525, #12375b, #071525) !important;
}

/* Main card */
.app-sign-in-register__content-inner {
  width: min(760px, 96vw) !important;
  max-width: 760px !important;
  box-sizing: border-box !important;
  margin: 0 auto !important;
  padding: 28px !important;

  background: var(--acfc-panel) !important;
  color: var(--acfc-text) !important;

  border: 1px solid var(--acfc-border) !important;
  border-radius: 24px !important;
  box-shadow:
    0 0 28px rgba(0,180,255,.12),
    0 25px 65px rgba(0,0,0,.35) !important;
}

/* Jenkins form title */
.app-sign-in-register__content-inner h1 {
  color: var(--acfc-text) !important;
  font-size: 30px !important;
  line-height: 1.3 !important;
  text-align: center !important;
  margin: 26px 0 22px !important;
}

/* ---------- HEADER AREA ---------- */
.acfc-login-header {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 8px;
}

.acfc-brand-block {
  text-align: center;
  margin-bottom: 18px;
}

.acfc-brand-block h2 {
  margin: 0 0 8px;
  color: #ffffff !important;
  font-size: clamp(26px, 3vw, 34px);
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: .8px;
}

.acfc-subtitle {
  margin: 0 0 7px;
  color: var(--acfc-cyan) !important;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .8px;
}

.acfc-frameworks {
  margin: 0;
  color: var(--acfc-soft) !important;
  font-size: 13px;
}

/* Layout under brand */
.acfc-hero-row {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 22px;
  align-items: center;
}

/* ---------- FULL ROBOT ---------- */
.acfc-full-robot-wrap {
  min-height: 340px;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at center, rgba(0,190,255,.08), transparent 60%);
  border-radius: 24px;
}

.acfc-full-robot {
  position: relative;
  width: 210px;
  height: 290px;
  animation: acfc-float 3.6s ease-in-out infinite;
  filter: drop-shadow(0 0 18px rgba(0, 215, 255, 0.20));
}

.acfc-antenna {
  position: absolute;
  top: 0;
  left: 103px;
  width: 4px;
  height: 24px;
  border-radius: 10px;
  background: #69eeff;
}

.acfc-antenna::before {
  content: "";
  position: absolute;
  top: -9px;
  left: -6px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #69eeff;
  box-shadow: 0 0 18px rgba(105,238,255,.9);
  animation: acfc-pulse 2.1s ease-in-out infinite;
}

.acfc-head {
  position: absolute;
  top: 18px;
  left: 42px;
  width: 126px;
  height: 104px;
  border-radius: 28px;
  box-sizing: border-box;
  background: linear-gradient(135deg, #0a84ff, #32d1ef);
  border: 3px solid #86f0ff;
  box-shadow: 0 0 18px rgba(78,223,255,.55);
}

.acfc-face {
  position: absolute;
  inset: 15px;
  border-radius: 18px;
  background: #071525;
}

.acfc-eyes {
  position: absolute;
  top: 24px;
  width: 100%;
  display: flex;
  justify-content: space-evenly;
}

.acfc-eyes span {
  width: 20px;
  height: 16px;
  border-radius: 50%;
  background: #69eeff;
  box-shadow: 0 0 14px rgba(105,238,255,.9);
  animation: acfc-blink 5s infinite;
}

.acfc-mouth {
  position: absolute;
  left: 50%;
  bottom: 18px;
  width: 38px;
  height: 14px;
  transform: translateX(-50%);
  border-bottom: 4px solid #69eeff;
  border-radius: 0 0 30px 30px;
}

.acfc-neck {
  position: absolute;
  top: 122px;
  left: 86px;
  width: 38px;
  height: 16px;
  border-radius: 6px;
  background: #1c92df;
}

.acfc-body {
  position: absolute;
  top: 138px;
  left: 52px;
  width: 106px;
  height: 88px;
  border-radius: 24px;
  box-sizing: border-box;
  background: linear-gradient(135deg, #097fff, #1fbfe9);
  border: 3px solid #7aefff;
  box-shadow: 0 0 18px rgba(78,223,255,.35);
}

.acfc-body-panel {
  position: absolute;
  inset: 14px 16px;
  border-radius: 14px;
  background: #071525;
}

.acfc-body-panel span {
  position: absolute;
  left: 50%;
  width: 12px;
  height: 12px;
  margin-left: -6px;
  border-radius: 50%;
  background: #5cf0ff;
  box-shadow: 0 0 10px rgba(92,240,255,.85);
}

.acfc-body-panel span:first-child { top: 14px; }
.acfc-body-panel span:last-child { bottom: 14px; }

.acfc-arm {
  position: absolute;
  top: 154px;
  width: 18px;
  height: 72px;
  border-radius: 18px;
  background: linear-gradient(180deg, #1ec4eb, #0d7ef9);
}

.acfc-arm.left {
  left: 24px;
  transform-origin: top center;
  animation: acfc-wave-left 3.4s ease-in-out infinite;
}

.acfc-arm.right {
  right: 24px;
  transform: rotate(-18deg);
}

.acfc-hand {
  position: absolute;
  bottom: -10px;
  left: 50%;
  width: 18px;
  height: 18px;
  margin-left: -9px;
  border-radius: 50%;
  background: #70f0ff;
  box-shadow: 0 0 10px rgba(112,240,255,.65);
}

.acfc-leg {
  position: absolute;
  top: 223px;
  width: 18px;
  height: 54px;
  border-radius: 18px;
  background: linear-gradient(180deg, #1ec4eb, #0d7ef9);
}

.acfc-leg.left { left: 78px; }
.acfc-leg.right { right: 78px; }

.acfc-foot {
  position: absolute;
  bottom: -8px;
  left: 50%;
  width: 34px;
  height: 12px;
  margin-left: -17px;
  border-radius: 16px;
  background: #1f95df;
}

/* ---------- GREETING BOX ---------- */
.acfc-greeting-box {
  background: var(--acfc-panel-2);
  border: 1px solid rgba(89,234,255,.28);
  border-radius: 18px;
  padding: 22px 20px;
  text-align: left;
}

.acfc-greeting-box h3 {
  margin: 0 0 12px;
  color: var(--acfc-cyan) !important;
  font-size: clamp(20px, 2.2vw, 28px) !important;
  line-height: 1.3;
}

.acfc-greeting-box p {
  margin: 8px 0;
  color: #e0f2ff !important;
  font-size: 14px !important;
  line-height: 1.6;
}

#acfc-farewell {
  color: #76f0bf !important;
  font-weight: 700;
}

.acfc-greeting-note {
  margin-top: 14px;
  padding-top: 10px;
  border-top: 1px solid rgba(90,200,255,.20);
  color: var(--acfc-muted);
  font-size: 12px;
}

/* ---------- NATIVE JENKINS FORM ---------- */
.app-sign-in-register form {
  width: 100% !important;
  max-width: 520px !important;
  margin: 0 auto !important;
  background: transparent !important;
}

.app-sign-in-register label {
  color: var(--acfc-soft) !important;
  font-size: 14px !important;
}

.app-sign-in-register input[type="text"],
.app-sign-in-register input[type="password"] {
  box-sizing: border-box !important;
  width: 100% !important;
  min-height: 46px !important;
  background: #07182e !important;
  color: #ffffff !important;
  border: 1px solid #3d688f !important;
  border-radius: 10px !important;
}

.app-sign-in-register input:focus-visible {
  outline: 2px solid var(--acfc-cyan) !important;
  outline-offset: 2px;
}

.app-sign-in-register input[type="checkbox"] {
  accent-color: #168cff;
}

.app-sign-in-register button[type="submit"],
.app-sign-in-register input[type="submit"] {
  width: 100% !important;
  min-height: 46px !important;
  background: linear-gradient(90deg, var(--acfc-btn1), var(--acfc-btn2)) !important;
  color: #ffffff !important;
  font-size: 15px !important;
  font-weight: 700 !important;
  border: none !important;
  border-radius: 10px !important;
}

/* ---------- FOOTER ---------- */
.acfc-login-footer {
  margin-top: 20px;
  text-align: center;
}

.acfc-login-footer p {
  margin: 4px 0;
  color: #c3d9ec !important;
  font-size: 12px !important;
  line-height: 1.6;
}

/* ---------- ANIMATIONS ---------- */
@keyframes acfc-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

@keyframes acfc-pulse {
  0%, 100% {
    opacity: .6;
    box-shadow: 0 0 8px rgba(99,239,255,.6);
  }
  50% {
    opacity: 1;
    box-shadow: 0 0 20px rgba(99,239,255,1);
  }
}

@keyframes acfc-blink {
  0%, 44%, 48%, 100% { transform: scaleY(1); }
  46% { transform: scaleY(.12); }
}

@keyframes acfc-wave-left {
  0%, 100% { transform: rotate(18deg); }
  50% { transform: rotate(4deg); }
}

/* ---------- RESPONSIVE ---------- */
@media (max-width: 760px) {
  .app-sign-in-register__content-inner {
    padding: 22px !important;
  }

  .acfc-hero-row {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .acfc-full-robot-wrap {
    min-height: 290px;
  }

  .app-sign-in-register__content-inner h1 {
    font-size: 26px !important;
    margin-top: 18px !important;
  }
}

@media (max-width: 480px) {
  .app-sign-in-register__content,
  #main-panel {
    padding: 12px !important;
  }

  .app-sign-in-register__content-inner {
    width: 100% !important;
    padding: 18px !important;
    border-radius: 18px !important;
  }

  .acfc-brand-block h2 {
    font-size: 24px;
  }

  .acfc-full-robot-wrap {
    min-height: 250px;
  }

  .acfc-full-robot {
    transform: scale(.9);
    transform-origin: center top;
  }

  .acfc-full-robot,
  .acfc-full-robot * {
    max-width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .acfc-full-robot,
  .acfc-eyes span,
  .acfc-antenna::before,
  .acfc-arm.left {
    animation: none !important;
  }
}
