
;WITH FolderTree AS
(
    -- Start from the Test Plan root
    SELECT
        A.AL_ITEM_ID,
        A.AL_FATHER_ID,
        A.AL_DESCRIPTION,
        CAST(A.AL_DESCRIPTION AS VARCHAR(MAX)) AS Full_Path,
        CAST(NULL AS VARCHAR(255)) AS Application,
        CAST(NULL AS VARCHAR(255)) AS Functional_Area,
        0 AS Folder_Level
    FROM [amfc_isqat_db].[td].ALL_LISTS A
    WHERE A.AL_DESCRIPTION = 'Subject'
      AND A.AL_FATHER_ID = 0

    UNION ALL

    -- Build complete folder hierarchy
    SELECT
        A.AL_ITEM_ID,
        A.AL_FATHER_ID,
        A.AL_DESCRIPTION,
        CAST(
            F.Full_Path + ' / ' + A.AL_DESCRIPTION
            AS VARCHAR(MAX)
        ) AS Full_Path,

        CAST(
            CASE
                WHEN F.Folder_Level = 0
                    THEN A.AL_DESCRIPTION
                ELSE F.Application
            END AS VARCHAR(255)
        ) AS Application,

        CAST(
            CASE
                WHEN F.Folder_Level = 1
                    THEN A.AL_DESCRIPTION
                ELSE F.Functional_Area
            END AS VARCHAR(255)
        ) AS Functional_Area,

        F.Folder_Level + 1
    FROM [amfc_isqat_db].[td].ALL_LISTS A
    INNER JOIN FolderTree F
        ON A.AL_FATHER_ID = F.AL_ITEM_ID
),

StepCount AS
(
    SELECT
        DS_TEST_ID,
        COUNT(*) AS Total_Steps
    FROM [amfc_isqat_db].[td].DESSTEPS
    GROUP BY DS_TEST_ID
)

SELECT
    F.Application AS [Application],
    F.Functional_Area AS [Functional Area],

    T.TS_TEST_ID AS [Test Case ID],
    T.TS_NAME AS [Test Case Name],

    F.Full_Path AS [Full Test Plan Path],

    ISNULL(S.Total_Steps, 0) AS [Total Steps],

    T.TS_RESPONSIBLE AS [Test Designer],
    T.TS_STATUS AS [Test Status],
    T.TS_TYPE AS [Test Type]

FROM [amfc_isqat_db].[td].TEST T

INNER JOIN FolderTree F
    ON T.TS_SUBJECT = F.AL_ITEM_ID

LEFT JOIN StepCount S
    ON T.TS_TEST_ID = S.DS_TEST_ID

WHERE ISNULL(S.Total_Steps, 0) < 5

ORDER BY
    F.Application,
    F.Functional_Area,
    F.Full_Path,
    ISNULL(S.Total_Steps, 0),
    T.TS_NAME

OPTION (MAXRECURSION 0);
