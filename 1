
/* ACFC Login - Final Polish */

.app-sign-in-register__content-inner {
    width: min(500px, 94vw) !important;
    max-width: 500px !important;
    padding: 40px !important;
}

.acfc-login-hero h2 {
    font-size: 23px !important;
}

.acfc-login-hero p {
    font-size: 13px !important;
    color: #c5e4ff !important;
}

.acfc-login-footer,
.acfc-login-footer p {
    color: #d0e5fa !important;
    font-size: 12px !important;
}

.app-sign-in-register__content-inner {
    border-color: #289cde !important;
    box-shadow:
      0 0 30px rgba(0,180,255,.23),
      0 20px 60px rgba(0,0,0,.3) !important;
}

@media (max-width: 600px) {
    .app-sign-in-register__content-inner {
        padding: 22px !important;
    }
}

