<script>
(function () {
  "use strict";

  function greet() {
    var title =
      document.getElementById("acfc-greeting");

    var closing =
      document.getElementById("acfc-farewell");

    if (!title || !closing) return;

    var hour = new Date().getHours();

    if (hour >= 5 && hour < 12) {
      title.textContent =
        "Hello! Good morning!";

      closing.textContent =
        "Have a wonderful day ahead!";

    } else if (hour >= 12 && hour < 17) {
      title.textContent =
        "Hello! Good afternoon!";

      closing.textContent =
        "Have a productive and successful day!";

    } else if (hour >= 17 && hour < 21) {
      title.textContent =
        "Hello! Good evening!";

      closing.textContent =
        "Have a relaxing evening!";

    } else {
      title.textContent =
        "Hello! Good night!";

      closing.textContent =
        "Have a peaceful night!";
    }
  }

  function startGreeting() {
    greet();

    window.setInterval(
      greet,
      60000
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      startGreeting
    );
  } else {
    startGreeting();
  }
})();
</script>
