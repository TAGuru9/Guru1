
/* ==========================================
   ACFC TA PRODUCTION
   AI AUTOMATION COMMAND CENTER
   Jenkins Native Login Theme
   ========================================== */

/* MAIN BACKGROUND */

body.app-sign-in-register:has(#acfc-command-center) {
  min-height: 100svh;

  background:
    radial-gradient(
      ellipse at 35% 28%,
      #0a4b8b 0%,
      #042656 44%,
      #02102b 100%
    ) !important;

  color: white;
  overflow-x: hidden;
}

/* ANIMATED BACKGROUND LIGHT */

body.app-sign-in-register:has(#acfc-command-center)::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;

  background:
    radial-gradient(
      circle at 84% 13%,
      #0be5fa38,
      transparent 27%
    ),
    radial-gradient(
      circle at 15% 75%,
      #164dd452,
      transparent 40%
    );

  animation: acfcAtmosphere 8s
    ease-in-out infinite alternate;
}

/* DECORATIVE LAYER */

#acfc-command-center {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

/* AI COMMAND CENTER ARTWORK */

#acfc-command-center .acfc-art {
  position: absolute;

  top: max(2vh, 12px);
  left: clamp(10px, 2vw, 45px);

  width: min(56vw, 940px);
  height: min(76vh, 690px);

  background:
    url('/userContent/acfc-login/acfc-command-center.webp')
    center top / contain no-repeat;

  filter:
    drop-shadow(0 0 18px #00c8ff22);

  animation:
    acfcArtBreathe 6s
    ease-in-out infinite;
}

/* GLOWING FRAMEWORK CONNECTIONS */

#acfc-command-center .acfc-signal {
  position: absolute;
  border: 1px solid #00deff35;
  border-radius: 50%;

  box-shadow:
    0 0 28px #00deff12;
}

#acfc-command-center .acfc-signal-1 {
  width: 29vw;
  height: 29vw;

  top: 16vh;
  left: 14vw;

  animation: acfcPulse 5s infinite;
}

#acfc-command-center .acfc-signal-2 {
  width: 37vw;
  height: 37vw;

  top: 11vh;
  left: 10vw;

  animation:
    acfcPulse 7s infinite reverse;
}

/* CI/CD PIPELINE */

#acfc-command-center .acfc-pipeline {
  position: absolute;

  bottom: clamp(73px, 10vh, 115px);
  left: 8%;
  width: 84%;

  display: flex;
  justify-content: center;
  align-items: center;

  gap: clamp(8px, 2vw, 32px);

  padding: 16px;
  box-sizing: border-box;

  border-radius: 40px;

  background:
    linear-gradient(
      90deg,
      #00589185,
      #0757a480,
      #07428685
    );

  border: 1px solid #20e7ff;

  box-shadow:
    0 0 18px #00eaff50,
    inset 0 0 20px #00dfff19;

  font:
    600 clamp(12px, 1.35vw, 19px)/1.4
    "Segoe UI", sans-serif;

  color: white;
}

/* PIPELINE ARROW ANIMATION */

#acfc-command-center .acfc-pipeline b {
  color: #54eaff;
  animation: acfcBlink 1.8s infinite;
}

/* HIDE DUPLICATE JENKINS BRANDING */

body.app-sign-in-register:has(#acfc-command-center)
> .app-sign-in-register__branding {
  display: none !important;
}

/* POSITION NATIVE JENKINS LOGIN */

body.app-sign-in-register:has(#acfc-command-center)
#main-panel.app-sign-in-register__content {

  position: relative;
  z-index: 2;

  display: flex;
  justify-content: flex-end;
  align-items: flex-start;

  min-height: 100svh;
  width: 100%;
  max-width: none;

  margin: 0;
  padding: 10vh 5vw 150px;

  box-sizing: border-box;

  background: transparent;
  box-shadow: none;
}

/* LOGIN CARD */

body.app-sign-in-register:has(#acfc-command-center)
.app-sign-in-register__content-inner {

  box-sizing: border-box;

  flex: 0 1 460px;
  width: min(100%, 460px);
  max-width: 460px;

  margin: 0;
  padding: 34px 35px 35px;

  border-radius: 26px;
  border: 2px solid #9debff;

  background:
    linear-gradient(
      155deg,
      #ffffff 0%,
      #eaf3ff 100%
    );

  color: #0e2345;

  box-shadow:
    0 16px 55px #000b2e66,
    0 0 24px #00ccff4d;
}

/* LOGIN HEADING */

body.app-sign-in-register:has(#acfc-command-center)
.app-sign-in-register__content-inner > h1 {

  font-size: 0 !important;
  line-height: 0;
  margin: 0 0 20px;

  text-align: center;
}

body.app-sign-in-register:has(#acfc-command-center)
.app-sign-in-register__content-inner > h1::after {

  content:
    "Jenkins  •  ACFC TA Production\A Enterprise Test Automation Portal";

  white-space: pre-line;
  display: block;

  font:
    700 21px/1.65
    "Segoe UI", Arial, sans-serif;

  color: #132b58;
}

/* KEEP THE REAL JENKINS FORM */

body.app-sign-in-register:has(#acfc-command-center)
form[name="login"] {

  display: block;
  width: 100%;

  background: transparent;

  margin: 0;
  padding: 0;
}

/* FORM LABELS */

body.app-sign-in-register:has(#acfc-command-center)
form[name="login"] label {

  color: #203b62;
  font-weight: 550;
}

/* USERNAME AND PASSWORD */

body.app-sign-in-register:has(#acfc-command-center)
form[name="login"]
input:not([type="hidden"]):not([type="checkbox"]) {

  width: 100%;
  min-height: 45px;

  box-sizing: border-box;

  border-radius: 10px;
  border: 1px solid #9bb8d9;

  background: white;
  color: #102b50;
}

/* KEYBOARD FOCUS */

body.app-sign-in-register:has(#acfc-command-center)
form[name="login"] input:focus-visible,

body.app-sign-in-register:has(#acfc-command-center)
form[name="login"] button:focus-visible {

  outline: 3px solid #13aaf7;
  outline-offset: 2px;
}

/* SIGN IN BUTTON */

body.app-sign-in-register:has(#acfc-command-center)
form[name="login"] button[type="submit"] {

  width: 100%;
  min-height: 46px;

  border-radius: 11px;

  background:
    linear-gradient(
      #128ffd,
      #004bd0
    );

  color: white;
  font-weight: 700;

  box-shadow:
    0 7px 17px #1269db42;
}

/* FOOTER */

#acfc-production-footer {
  position: fixed;

  bottom: 0;
  left: 0;

  width: 100%;
  z-index: 4;

  box-sizing: border-box;

  min-height: 52px;
  padding: 15px 20px;

  text-align: center;

  background: #061b41dd;
  border-top: 1px solid #1de5ff66;

  color: #f6fcff;

  font:
    500 13px/1.5
    "Segoe UI", sans-serif;
}

#acfc-production-footer span {
  padding: 0 18px;
  color: #70e9ff;
}

/* TABLET VIEW */

@media (max-width: 900px) {

  #acfc-command-center .acfc-art {
    width: 65vw;
    height: 52vh;
    opacity: 0.52;
  }

  #acfc-command-center .acfc-pipeline {
    left: 4%;
    width: 92%;
    bottom: 73px;

    gap: 9px;
    flex-wrap: wrap;
  }

  body.app-sign-in-register:has(#acfc-command-center)
  #main-panel.app-sign-in-register__content {

    align-items: center;
    justify-content: center;

    padding: 24px 18px 150px;
  }

  body.app-sign-in-register:has(#acfc-command-center)
  .app-sign-in-register__content-inner {

    flex-basis: 440px;
    background: #f8fbfffa;
  }
}

/* MOBILE VIEW */

@media (max-width: 500px) {

  #acfc-command-center .acfc-art {
    width: 94vw;
    height: 42vh;

    left: 2vw;
    top: 5px;

    opacity: 0.32;
  }

  body.app-sign-in-register:has(#acfc-command-center)
  .app-sign-in-register__content-inner {

    padding: 25px 20px;
  }

  #acfc-command-center .acfc-pipeline {
    font-size: 11px;
    padding: 10px;
  }
}

/* ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {

  body.app-sign-in-register:has(#acfc-command-center)::before,
  #acfc-command-center *,
  #acfc-command-center *::before {

    animation: none !important;
  }
}

/* ANIMATION KEYFRAMES */

@keyframes acfcArtBreathe {

  0%, 100% {
    transform: translateY(0);
    opacity: 1;
  }

  50% {
    transform: translateY(-5px);
    opacity: 0.96;
  }
}

@keyframes acfcPulse {

  0%, 100% {
    opacity: 0.25;
    transform: scale(0.98);
  }

  50% {
    opacity: 0.58;
    transform: scale(1.03);
  }
}

@keyframes acfcAtmosphere {

  from {
    opacity: 0.55;
  }

  to {
    opacity: 1;
  }
}

@keyframes acfcBlink {

  0%, 100% {
    opacity: 0.5;
  }

  50% {
    opacity: 1;
  }
}
