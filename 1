
/* =====================================
   ACFC TA - RIGHT PANEL REPAIR V5
   ===================================== */

/* Ensure the main container has room */
.app-sign-in-register__content-inner {
    position: relative !important;
    display: block !important;
    box-sizing: border-box !important;

    width: min(1100px, 96vw) !important;
    max-width: 1100px !important;
    min-width: 0 !important;
    min-height: 650px !important;

    padding: 65px 48px 45px 55% !important;
    margin: 20px auto !important;

    overflow: hidden !important;
}

/* Left robot panel */
.acfc-split-hero {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;

    width: 50% !important;
    height: 100% !important;
    box-sizing: border-box !important;

    padding: 30px !important;
}

/* Stop form elements collapsing */
.app-sign-in-register__content-inner
  > :not(.acfc-split-hero) {
    box-sizing: border-box !important;
    grid-area: auto !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    float: none !important;
}

/* Jenkins sign-in heading */
.app-sign-in-register__content-inner h1 {
    display: block !important;
    width: 100% !important;
    max-width: none !important;

    margin: 0 0 25px !important;
    padding: 0 !important;

    font-size: 28px !important;
    line-height: 1.3 !important;
    text-align: left !important;
    white-space: normal !important;
    overflow-wrap: normal !important;
}

/* Native login form */
.app-sign-in-register form {
    display: block !important;
    box-sizing: border-box !important;

    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;

    margin: 0 !important;
    padding: 0 !important;

    background: transparent !important;
    border: none !important;
}

/* Input fields */
.app-sign-in-register input[type="text"],
.app-sign-in-register input[type="password"] {
    display: block !important;
    box-sizing: border-box !important;

    width: 100% !important;
    min-height: 46px !important;
}

/* Sign-in button */
.app-sign-in-register button[type="submit"],
.app-sign-in-register input[type="submit"] {
    display: block !important;
    width: 100% !important;
    min-height: 46px !important;
}

/* Footer */
.acfc-login-footer {
    box-sizing: border-box !important;
    display: block !important;

    width: 100% !important;
    max-width: none !important;

    margin: 28px 0 0 !important;
    text-align: center !important;
}

/* Mobile */
@media (max-width: 850px) {
    .app-sign-in-register__content-inner {
        width: min(520px, 96vw) !important;
        min-height: auto !important;
        padding: 24px !important;
    }

    .acfc-split-hero {
        position: relative !important;
        width: 100% !important;
        height: auto !important;
        margin-bottom: 25px !important;
    }
}
