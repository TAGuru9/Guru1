
/* ==================================
   ACFC LOGIN - LAYOUT FIX V3
   Overrides the previous grid layout
   ================================== */

/* Main panel: no CSS grid */
.app-sign-in-register__content-inner {
  position: relative !important;
  display: block !important;

  box-sizing: border-box !important;
  width: min(1050px, 96vw) !important;
  max-width: 1050px !important;
  min-height: 620px !important;

  padding: 65px 45px 45px 54% !important;

  background: #10233b !important;
  border: 1px solid #376b93 !important;
  border-radius: 24px !important;
  overflow: hidden !important;
}

/* Robot and explanation: left side */
.acfc-split-hero {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;

  box-sizing: border-box !important;
  width: 50% !important;
  height: 100% !important;

  padding: 28px 30px !important;
  overflow-y: auto !important;

  background: linear-gradient(
    155deg,
    #0a2945,
    #071726
  ) !important;

  border-right: 1px solid #315774 !important;
}

/* Improve branding */
.acfc-hero-brand h2 {
  font-size: 27px !important;
  line-height: 1.2 !important;
}

.acfc-hero-brand .acfc-subtitle {
  font-size: 13px !important;
}

.acfc-hero-brand .acfc-frameworks {
  font-size: 13px !important;
}

/* Robot positioning */
.acfc-robot-stage {
  height: 270px !important;
  margin: 8px 0 12px !important;
}

/* Explanation */
.acfc-info-box {
  padding: 18px !important;
}

.acfc-info-box h3 {
  font-size: 19px !important;
}

.acfc-info-box p,
.acfc-info-box li {
  font-size: 13px !important;
  line-height: 1.6 !important;
}

/* Native Jenkins heading stays right */
.app-sign-in-register__content-inner h1 {
  display: block !important;
  margin: 0 0 22px !important;
  padding: 0 !important;

  font-size: 29px !important;
  text-align: left !important;
  color: white !important;
}

/* Preserve normal form flow */
.app-sign-in-register form {
  display: block !important;
  box-sizing: border-box !important;

  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 20px 0 !important;

  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

/* Clear legacy grid positioning */
.app-sign-in-register__content-inner
> :not(.acfc-split-hero) {
  grid-area: auto !important;
  max-width: 100% !important;
}

/* Consistent native form spacing */
.app-sign-in-register label {
  font-size: 14px !important;
  color: #d5e9fb !important;
}

/* Keep the checkbox visible */
.app-sign-in-register
input[type="checkbox"] {
  accent-color: #168cff;
}

/* Inputs */
.app-sign-in-register input[type="text"],
.app-sign-in-register input[type="password"] {
  box-sizing: border-box !important;
  width: 100% !important;
  min-height: 46px !important;
}

/* Sign-in button */
.app-sign-in-register button[type="submit"],
.app-sign-in-register input[type="submit"] {
  width: 100% !important;
  min-height: 46px !important;
}

/* Footer stays with login */
.acfc-login-footer {
  display: block !important;
  margin: 28px 0 0 !important;
  padding: 0 !important;
  text-align: center !important;
}

.acfc-login-footer p {
  color: #c5ddef !important;
  font-size: 12px !important;
}

/* Mobile: return to one column */
@media (max-width: 850px) {
  .app-sign-in-register__content-inner {
    width: min(520px, 96vw) !important;
    min-height: 0 !important;
    padding: 25px !important;
  }

  .acfc-split-hero {
    position: relative !important;
    width: 100% !important;
    height: auto !important;
    padding: 20px !important;
    margin-bottom: 28px !important;
    border-right: none !important;
    border-radius: 15px;
  }

  .acfc-login-footer {
    margin-top: 20px !important;
  }
}

