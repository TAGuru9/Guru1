
;WITH FolderTree AS
(
    SELECT
        RF_ID,
        RF_PARENT_ID,
        RF_NAME,
        CAST(RF_NAME AS VARCHAR(MAX)) AS Folder_Path,
        CAST(RF_NAME AS VARCHAR(255)) AS Parent_Folder,
        0 AS Folder_Level
    FROM [amfc_isqat_db].[td].RELEASE_FOLDERS
    WHERE RF_NAME = '2026 Releases'

    UNION ALL

    SELECT
        f.RF_ID,
        f.RF_PARENT_ID,
        f.RF_NAME,
        CAST(
            p.Folder_Path + ' / ' + f.RF_NAME
            AS VARCHAR(MAX)
        ),
        CAST(
            CASE
                WHEN p.Folder_Level = 0
                THEN f.RF_NAME
                ELSE p.Parent_Folder
            END AS VARCHAR(255)
        ),
        p.Folder_Level + 1
    FROM [amfc_isqat_db].[td].RELEASE_FOLDERS f
    INNER JOIN FolderTree p
        ON f.RF_PARENT_ID = p.RF_ID
),

ReleaseCycles AS
(
    SELECT
        f.Parent_Folder,
        rel.REL_NAME AS Release_Name,
        rc.RCYC_ID,
        rc.RCYC_NAME AS Cycle_Name,

        CAST(rc.RCYC_START_DATE AS DATE)
            AS Cycle_Start,

        CAST(rc.RCYC_END_DATE AS DATE)
            AS Cycle_End,

        CAST(rc.RCYC_START_DATE AS DATE)
            AS Week1_Start,

        DATEADD(
            DAY, 7,
            CAST(rc.RCYC_START_DATE AS DATE)
        ) AS Week1_End_Exclusive

    FROM [amfc_isqat_db].[td].RELEASES rel

    INNER JOIN FolderTree f
        ON rel.REL_PARENT_ID = f.RF_ID

    INNER JOIN [amfc_isqat_db].[td].RELEASE_CYCLES rc
        ON rc.RCYC_PARENT_ID = rel.REL_ID

    WHERE rc.RCYC_START_DATE >=
          DATEFROMPARTS(YEAR(GETDATE()), 1, 1)
      AND rc.RCYC_START_DATE <
          DATEFROMPARTS(YEAR(GETDATE()) + 1, 1, 1)
),

DefectMetrics AS
(
    SELECT
        rc.RCYC_ID,

        COUNT(DISTINCT bg.BG_BUG_ID)
            AS Total_Defects,

        COUNT(DISTINCT CASE
            WHEN bg.BG_DETECTION_DATE >= rc.Week1_Start
             AND bg.BG_DETECTION_DATE <
                 rc.Week1_End_Exclusive
            THEN bg.BG_BUG_ID
        END) AS First_Week_Defects

    FROM ReleaseCycles rc

    LEFT JOIN [amfc_isqat_db].[td].BUG bg
        ON bg.BG_DETECTED_IN_RCYC = rc.RCYC_ID
       AND bg.BG_DETECTION_DATE >= rc.Cycle_Start
       AND bg.BG_DETECTION_DATE <
           DATEADD(DAY, 1, rc.Cycle_End)

    GROUP BY rc.RCYC_ID
),

-- All execution runs, including repeat runs
AllRuns AS
(
    SELECT
        c.CY_ASSIGN_RCYC AS RCYC_ID,
        r.RN_RUN_ID,
        r.RN_TESTCYCL_ID,
        r.RN_STATUS,
        r.RN_EXECUTION_DATE

    FROM [amfc_isqat_db].[td].RUN r

    INNER JOIN [amfc_isqat_db].[td].TESTCYCL tc
        ON r.RN_TESTCYCL_ID = tc.TC_TESTCYCL_ID

    INNER JOIN [amfc_isqat_db].[td].CYCLE c
        ON tc.TC_CYCLE_ID = c.CY_CYCLE_ID
),

ExecutionMetrics AS
(
    SELECT
        rc.RCYC_ID,

        -- All runs across the entire cycle
        COUNT(ar.RN_RUN_ID)
            AS Total_Execution_Runs,

        SUM(CASE
            WHEN ar.RN_STATUS = 'Passed'
            THEN 1 ELSE 0
        END) AS Total_Passed_Runs,

        SUM(CASE
            WHEN ar.RN_STATUS = 'Failed'
            THEN 1 ELSE 0
        END) AS Total_Failed_Runs,

        SUM(CASE
            WHEN ar.RN_STATUS NOT IN ('Passed', 'Failed')
                 OR ar.RN_STATUS IS NULL
            THEN 1 ELSE 0
        END) AS Other_Status_Runs,

        -- All runs during the first 7 days
        SUM(CASE
            WHEN ar.RN_EXECUTION_DATE >= rc.Week1_Start
             AND ar.RN_EXECUTION_DATE <
                 rc.Week1_End_Exclusive
            THEN 1 ELSE 0
        END) AS First_Week_Runs,

        SUM(CASE
            WHEN ar.RN_STATUS = 'Passed'
             AND ar.RN_EXECUTION_DATE >= rc.Week1_Start
             AND ar.RN_EXECUTION_DATE <
                 rc.Week1_End_Exclusive
            THEN 1 ELSE 0
        END) AS First_Week_Passed_Runs,

        SUM(CASE
            WHEN ar.RN_STATUS = 'Failed'
             AND ar.RN_EXECUTION_DATE >= rc.Week1_Start
             AND ar.RN_EXECUTION_DATE <
                 rc.Week1_End_Exclusive
            THEN 1 ELSE 0
        END) AS First_Week_Failed_Runs

    FROM ReleaseCycles rc

    LEFT JOIN AllRuns ar
        ON ar.RCYC_ID = rc.RCYC_ID
       AND ar.RN_EXECUTION_DATE >= rc.Cycle_Start
       AND ar.RN_EXECUTION_DATE <
           DATEADD(DAY, 1, rc.Cycle_End)

    GROUP BY rc.RCYC_ID
)

SELECT
    rc.Parent_Folder,
    rc.Release_Name,
    rc.Cycle_Name,
    rc.Cycle_Start,
    rc.Cycle_End,

    -- Defect metrics
    dm.Total_Defects,
    dm.First_Week_Defects,

    CAST(
        100.0 * dm.First_Week_Defects /
        NULLIF(dm.Total_Defects, 0)
        AS DECIMAL(6,2)
    ) AS First_Week_Defect_Percentage,

    -- Complete cycle execution metrics
    em.Total_Execution_Runs,
    em.Total_Passed_Runs,
    em.Total_Failed_Runs,
    em.Other_Status_Runs,

    CAST(
        100.0 * em.Total_Passed_Runs /
        NULLIF(em.Total_Execution_Runs, 0)
        AS DECIMAL(6,2)
    ) AS Overall_Run_Pass_Percentage,

    CAST(
        100.0 * em.Total_Failed_Runs /
        NULLIF(em.Total_Execution_Runs, 0)
        AS DECIMAL(6,2)
    ) AS Overall_Run_Failure_Percentage,

    -- First-week execution metrics
    em.First_Week_Runs,
    em.First_Week_Passed_Runs,
    em.First_Week_Failed_Runs,

    CAST(
        100.0 * em.First_Week_Passed_Runs /
        NULLIF(em.First_Week_Runs, 0)
        AS DECIMAL(6,2)
    ) AS First_Week_Run_Pass_Percentage,

    CAST(
        100.0 * em.First_Week_Failed_Runs /
        NULLIF(em.First_Week_Runs, 0)
        AS DECIMAL(6,2)
    ) AS First_Week_Run_Failure_Percentage

FROM ReleaseCycles rc

LEFT JOIN DefectMetrics dm
    ON dm.RCYC_ID = rc.RCYC_ID

LEFT JOIN ExecutionMetrics em
    ON em.RCYC_ID = rc.RCYC_ID

ORDER BY
    rc.Parent_Folder,
    rc.Release_Name,
    rc.Cycle_Start

OPTION (MAXRECURSION 0);
