<div class="acfc-login-header">

  <div class="acfc-brand-block">
    <h2>ACFC TA PRODUCTION</h2>
    <p class="acfc-subtitle">TEST AUTOMATION COMMAND CENTER</p>
    <p class="acfc-frameworks">PepperMill | PepperAPI | PepperWare | Tidal</p>
  </div>

  <div class="acfc-hero-row">

    <div class="acfc-full-robot-wrap" aria-hidden="true">
      <div class="acfc-full-robot">

        <div class="acfc-antenna"></div>

        <div class="acfc-head">
          <div class="acfc-face">
            <div class="acfc-eyes">
              <span></span>
              <span></span>
            </div>
            <div class="acfc-mouth"></div>
          </div>
        </div>

        <div class="acfc-neck"></div>

        <div class="acfc-body">
          <div class="acfc-body-panel">
            <span></span>
            <span></span>
          </div>
        </div>

        <div class="acfc-arm left"><div class="acfc-hand"></div></div>
        <div class="acfc-arm right"><div class="acfc-hand"></div></div>

        <div class="acfc-leg left"><div class="acfc-foot"></div></div>
        <div class="acfc-leg right"><div class="acfc-foot"></div></div>

      </div>
    </div>

    <div class="acfc-greeting-box">
      <h3 id="acfc-greeting">Hello! Welcome!</h3>
      <p id="acfc-welcome">Welcome to ACFC TA Production.</p>
      <p id="acfc-farewell">Wishing you a great day!</p>

      <div class="acfc-greeting-note">
        Secure Jenkins access for authorized users
      </div>
    </div>

  </div>

</div>

<script>
(function () {
  function updateGreeting() {
    var g = document.getElementById("acfc-greeting");
    var w = document.getElementById("acfc-welcome");
    var f = document.getElementById("acfc-farewell");
    if (!g || !w || !f) return;

    var hour = new Date().getHours();

    if (hour >= 5 && hour < 12) {
      g.textContent = "Hello! Good morning!";
      w.textContent = "Welcome to ACFC TA Production.";
      f.textContent = "Have a wonderful day ahead!";
    } else if (hour >= 12 && hour < 17) {
      g.textContent = "Hello! Good afternoon!";
      w.textContent = "Welcome to ACFC TA Production.";
      f.textContent = "Have a productive day!";
    } else if (hour >= 17 && hour < 21) {
      g.textContent = "Hello! Good evening!";
      w.textContent = "Welcome to ACFC TA Production.";
      f.textContent = "Have a relaxing evening!";
    } else {
      g.textContent = "Hello! Good night!";
      w.textContent = "Welcome to ACFC TA Production.";
      f.textContent = "Have a peaceful night!";
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", updateGreeting);
  } else {
    updateGreeting();
  }
})();
</script>
