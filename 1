DECLARE @Year INT = 2026;

;WITH DefectData AS
(
    SELECT
        B.BG_BUG_ID AS Defect_ID,
        YEAR(B.BG_DETECTION_DATE) AS Defect_Year,

        COALESCE(
            NULLIF(LTRIM(RTRIM(B.BG_PROJECT)), ''),
            'Not Assigned'
        ) AS Application,

        CASE
            WHEN UPPER(LTRIM(RTRIM(B.BG_USER_01))) = 'QA'
                THEN 'QA'

            WHEN UPPER(LTRIM(RTRIM(B.BG_USER_01)))
                 IN ('UAT', 'UAT_SSC')
                THEN 'UAT'

            ELSE 'OTHER'
        END AS Detected_Phase

    FROM [amfc_isqat_db].[td].[BUG] B

    WHERE B.BG_DETECTION_DATE >= DATEFROMPARTS(@Year, 1, 1)
      AND B.BG_DETECTION_DATE < DATEFROMPARTS(@Year + 1, 1, 1)
)

SELECT
    Defect_Year,

    CASE
        WHEN GROUPING(Application) = 1
            THEN 'GRAND TOTAL'
        ELSE Application
    END AS Application,

    COUNT(DISTINCT CASE
        WHEN Detected_Phase = 'QA'
        THEN Defect_ID
    END) AS QA_Defects,

    COUNT(DISTINCT CASE
        WHEN Detected_Phase = 'UAT'
        THEN Defect_ID
    END) AS UAT_Defects,

    COUNT(DISTINCT Defect_ID) AS Total_Defects,

    CAST(
        100.0 * COUNT(DISTINCT CASE
            WHEN Detected_Phase = 'UAT'
            THEN Defect_ID END)
        / NULLIF(COUNT(DISTINCT Defect_ID), 0)
        AS DECIMAL(10,2)
    ) AS UAT_Percentage

FROM DefectData
WHERE Detected_Phase IN ('QA', 'UAT')

GROUP BY ROLLUP (Defect_Year, Application)

HAVING GROUPING(Defect_Year) = 0

ORDER BY
    GROUPING(Application),
    Application;
