
;WITH CycleDefects AS
(
    SELECT
        rel.REL_NAME AS Release_Name,
        rc.RCYC_ID,
        rc.RCYC_NAME AS Cycle_Name,
        CAST(rc.RCYC_START_DATE AS DATE)
            AS Cycle_Start,
        CAST(rc.RCYC_END_DATE AS DATE)
            AS Cycle_End,
        CAST(rc.RCYC_START_DATE AS DATE)
            AS Week1_Start,

        COUNT(DISTINCT bg.BG_BUG_ID)
            AS Total_Defects,

        COUNT(DISTINCT CASE
            WHEN bg.BG_DETECTION_DATE >=
                 CAST(rc.RCYC_START_DATE AS DATE)
             AND bg.BG_DETECTION_DATE <
                 DATEADD(
                     DAY, 7,
                     CAST(rc.RCYC_START_DATE AS DATE)
                 )
            THEN bg.BG_BUG_ID
        END) AS First_Week_Defects

    FROM [amfc_isqat_db].[td].RELEASE_CYCLES rc

    INNER JOIN [amfc_isqat_db].[td].RELEASES rel
        ON rel.REL_ID = rc.RCYC_PARENT_ID

    LEFT JOIN [amfc_isqat_db].[td].BUG bg
        ON bg.BG_DETECTED_IN_RCYC = rc.RCYC_ID

    WHERE rc.RCYC_START_DATE >=
          DATEFROMPARTS(YEAR(GETDATE()), 1, 1)
      AND rc.RCYC_START_DATE <
          DATEFROMPARTS(YEAR(GETDATE()) + 1, 1, 1)

    GROUP BY
        rel.REL_NAME,
        rc.RCYC_ID,
        rc.RCYC_NAME,
        rc.RCYC_START_DATE,
        rc.RCYC_END_DATE
)

SELECT
    Release_Name,
    Cycle_Name,
    Cycle_Start,
    Cycle_End,
    Total_Defects,
    First_Week_Defects,

    CAST(
        100.0 * First_Week_Defects /
        NULLIF(Total_Defects, 0)
        AS DECIMAL(6,2)
    ) AS First_Week_Defect_Percentage

FROM CycleDefects

ORDER BY
    Release_Name,
    Cycle_Start;
